flowchart TD
    %% ============================================
    %% INFRASTRUCTURE PHYSIQUE
    %% ============================================
    subgraph Hardware [Infrastructure Physique - Serveur Unique]
        GPU[GPU: NVIDIA L40S - 48GB VRAM<br/>vLLM: 23GB, Embeddings: 3GB, Buffer: 22GB]
        CPU[CPU: 32+ cores<br/>Ingestion Parallèle]
        RAM[RAM: 128GB+<br/>Queue Buffer + Cache]
        Disk[Stockage: 2TB NVMe RAID 1<br/>Documents + Index + Logs]
    end

    %% ============================================
    %% STOCKAGE & SURVEILLANCE FICHIERS
    %% ============================================
    subgraph FileSystem [Stockage & Surveillance]
        Files[Documents Source<br/>PDF, XLSX, TIF, PPTX, DOCX, JPG]
        Watcher[File System Watcher<br/>inotify / watchdog<br/>Scan: 1min interval]
        Dedup[Deduplication<br/>SHA-256 Hash Check]
        Versioning[(Version Store<br/>Git-like Tracking)]
    end

    %% ============================================
    %% OBSERVABILITÉ & MONITORING
    %% ============================================
    subgraph Observability [Monitoring & Logs - Stack ELK + Prometheus]
        Prometheus[Prometheus<br/>Métriques Temps Réel<br/>- Latence P95/P99<br/>- GPU Utilization<br/>- Queue Depth]
        Grafana[Grafana Dashboards<br/>- Pipeline Health<br/>- Search Analytics<br/>- Resource Usage]
        Loki[Loki Log Aggregator<br/>Logs Centralisés]
        Jaeger[Jaeger Tracing<br/>Distributed Spans]
        AlertManager[AlertManager<br/>Notifications Slack/Email]
    end

    %% ============================================
    %% PIPELINE INGESTION AVEC GESTION D'ERREURS
    %% ============================================
    subgraph Ingestion [Pipeline ETL Asynchrone avec Error Handling]
        PrimaryQueue[Primary Queue<br/>Redis Stream<br/>FIFO + Priority]
        DLQ[Dead Letter Queue<br/>Échecs Persistants<br/>+ Manual Retry UI]
        
        Router{Type Router<br/>+ File Validation}
        
        %% Preprocessing commun
        Preprocess[Preprocessing Layer<br/>- Détection Langue<br/>- Nettoyage Headers/Footers<br/>- Format Validation]
        
        %% Branches spécialisées avec retry
        subgraph TableBranch [Branch: Documents Structurés]
            ParserXLS[Table Parser<br/>Deep Doc Understanding<br/>Preserve Spatial Context]
            RetryXLS{Retry Logic<br/>3 tentatives<br/>Exp Backoff}
        end
        
        subgraph VisionBranch [Branch: Documents Visuels]
            OCR[OCR Engine<br/>Tesseract + LayoutLMv3<br/>Text + Bounding Boxes]
            RetryOCR{Retry Logic<br/>3 tentatives}
        end
        
        subgraph TextBranch [Branch: Documents Textuels]
            ParserPDF[Layout Analysis<br/>PDFPlumber + Unstructured<br/>Detect Headers/Sections]
            RetryPDF{Retry Logic<br/>3 tentatives}
        end
        
        %% Chunking intelligent
        Chunker[Smart Chunker<br/>- Excel: Template-based Rows<br/>- Text: Semantic + Overlap 128 tok<br/>- Max: 512 tokens/chunk]
        
        %% Embedding avec batch
        EmbedBatch[Batch Embedder<br/>BGE-M3 or E5-Large<br/>Batch Size: 32<br/>Dim: 1024]
        
        %% Circuit Breaker
        CircuitBreaker{Circuit Breaker<br/>Protect GPU<br/>Fail Fast si Overload}
    end

    %% ============================================
    %% BATCH PROCESSING NOCTURNE
    %% ============================================
    subgraph BatchScheduler [Batch Processing Scheduler]
        Cron[Cron Scheduler<br/>Off-Peak: 22h-6h]
        BatchQueue[Batch Queue<br/>Low Priority<br/>Bulk Ingestion]
        RateLimit[Rate Limiter<br/>Max 100 docs/min<br/>Évite Saturation GPU]
    end

    %% ============================================
    %% STOCKAGE VECTORIEL HYBRIDE
    %% ============================================
    subgraph Storage [Base Vectorielle - Qdrant Cluster]
        VectorDB[Qdrant Collection<br/>HNSW Index + Payload]
        
        DenseVec[(Dense Vectors<br/>1024-dim<br/>Cosine Similarity)]
        SparseVec[(Sparse Vectors<br/>BM25 Inverted Index<br/>Exact Match)]
        Metadata[(Metadata Store<br/>- Source Path<br/>- Page Number<br/>- User Permissions<br/>- Timestamp<br/>- Language)]
        
        Snapshot[Backup Scheduler<br/>Snapshots Quotidiens<br/>S3 / NAS]
    end

    %% ============================================
    %% COUCHE CACHE MULTI-NIVEAUX
    %% ============================================
    subgraph CacheLayer [Cache Intelligent - Redis]
        SemanticCache[Semantic Cache<br/>Embedding Similarity<br/>Threshold: 0.95]
        QueryCache[Query Cache<br/>Exact Match<br/>TTL: 1 heure]
        ResultCache[Result Cache<br/>Top-K Docs<br/>TTL: 30 min]
        SessionCache[Session Store<br/>Conversation History<br/>Sliding Window: 10 turns]
    end

    %% ============================================
    %% API GATEWAY & AUTHENTIFICATION
    %% ============================================
    subgraph APILayer [API Gateway - FastAPI]
        LB[Load Balancer<br/>Nginx/Traefik<br/>SSL Termination]
        
        Auth[Auth Service<br/>OAuth 2.0 / JWT<br/>Keycloak Integration]
        
        RBAC[RBAC Engine<br/>User → Document ACL<br/>Middleware Validation]
        
        RateLimiter[Rate Limiter<br/>Per User:<br/>- 100 req/min<br/>- 10 LLM calls/min]
        
        APIEndpoints[REST Endpoints<br/>POST /search<br/>POST /chat<br/>GET /health<br/>WS /stream]
    end

    %% ============================================
    %% MOTEUR DE RECHERCHE & INFERENCE
    %% ============================================
    subgraph Serving [Search Engine & LLM Serving]
        User([User Query])
        
        QueryPreprocess[Query Processing<br/>- Spell Check<br/>- Expansion<br/>- Intent Detection]
        
        QueryEmbed[Query Encoder<br/>Same Model as Docs<br/>GPU Accelerated]
        
        HybridSearch{Hybrid Search<br/>α·Dense + β·Sparse<br/>α=0.7, β=0.3}
        
        Reranker[Neural Reranker<br/>BGE-Reranker-v2<br/>Cross-Encoder]
        
        RRF[Reciprocal Rank Fusion<br/>k=60<br/>Merge Top-20 from Each]
        
        ContextBuilder[Context Assembly<br/>- Top-5 Chunks<br/>- Metadata Injection<br/>- Max 2048 tokens]
        
        PromptTemplate[Prompt Manager<br/>Jinja2 Templates<br/>Role-based Instructions]
        
        LLMEngine[vLLM Server<br/>PagedAttention<br/>Continuous Batching<br/>Max Batch: 16]
        
        Model[Mixtral 8x7B-Instruct<br/>AWQ INT4 Quant<br/>Context: 32k tokens]
        
        ResponseValidation[Response Validator<br/>- Hallucination Check<br/>- Citation Verification<br/>- Safety Filter]
        
        StreamManager[Streaming Manager<br/>WebSocket<br/>Token-by-Token]
    end

    %% ============================================
    %% HEALTH CHECKS
    %% ============================================
    subgraph HealthSystem [Health Monitoring]
        HealthAPI[ /health Endpoint<br/>Component Status]
        Readiness[Readiness Probe<br/>DB + LLM Ready]
        Liveness[Liveness Probe<br/>Heartbeat Check]
    end

    %% ============================================
    %% FLUX DE DONNÉES - INGESTION
    %% ============================================
    
    Files --> Watcher
    Watcher -- "File Event" --> Dedup
    Dedup -- "New/Modified" --> Versioning
    Dedup -- "Enqueue" --> PrimaryQueue
    
    %% Batch scheduling
    Cron -- "Trigger Bulk Ingestion" --> BatchQueue
    BatchQueue --> RateLimit
    RateLimit --> PrimaryQueue
    
    PrimaryQueue --> Router
    
    Router -- "*.xlsx, *.csv" --> Preprocess
    Router -- "*.tif, *.png, *.jpg" --> Preprocess
    Router -- "*.pdf, *.docx, *.pptx" --> Preprocess
    
    Preprocess --> ParserXLS
    Preprocess --> OCR
    Preprocess --> ParserPDF
    
    ParserPDF -. "Si Scan Détecté" .-> OCR
    
    %% Error handling
    ParserXLS --> RetryXLS
    OCR --> RetryOCR
    ParserPDF --> RetryPDF
    
    RetryXLS -- "Success" --> Chunker
    RetryXLS -- "Max Retries Failed" --> DLQ
    RetryOCR -- "Success" --> Chunker
    RetryOCR -- "Failed" --> DLQ
    RetryPDF -- "Success" --> Chunker
    RetryPDF -- "Failed" --> DLQ
    
    Chunker --> EmbedBatch
    EmbedBatch --> CircuitBreaker
    CircuitBreaker -- "Healthy" --> VectorDB
    CircuitBreaker -- "Overload" --> DLQ
    
    VectorDB --> DenseVec & SparseVec & Metadata
    VectorDB --> Snapshot
    
    %% ============================================
    %% FLUX DE DONNÉES - SERVING
    %% ============================================
    
    User --> LB
    LB --> Auth
    Auth -- "Valid Token" --> RBAC
    RBAC -- "Authorized" --> RateLimiter
    RateLimiter -- "Within Limit" --> APIEndpoints
    
    APIEndpoints --> QueryPreprocess
    
    %% Check cache first
    QueryPreprocess --> QueryCache
    QueryCache -- "Cache Miss" --> QueryEmbed
    QueryCache -- "Cache Hit" --> User
    
    QueryEmbed --> SemanticCache
    SemanticCache -- "Similar Query Found" --> ResultCache
    SemanticCache -- "No Match" --> HybridSearch
    
    ResultCache -- "Hit" --> ContextBuilder
    ResultCache -- "Miss" --> HybridSearch
    
    %% Search execution
    DenseVec -.-> HybridSearch
    SparseVec -.-> HybridSearch
    Metadata -.-> HybridSearch
    
    HybridSearch -- "Top-20 Candidates" --> Reranker
    Reranker -- "Scored Results" --> RRF
    RRF -- "Top-5 Final" --> ContextBuilder
    
    ContextBuilder --> PromptTemplate
    PromptTemplate --> SessionCache
    SessionCache -- "+ History" --> LLMEngine
    
    LLMEngine --> Model
    Model -- "Generated Response" --> ResponseValidation
    ResponseValidation -- "Safe Output" --> StreamManager
    StreamManager --> User
    
    %% Store response in cache
    StreamManager -.-> QueryCache
    StreamManager -.-> ResultCache
    
    %% ============================================
    %% MONITORING CONNECTIONS
    %% ============================================
    
    PrimaryQueue -.-> Prometheus
    DLQ -.-> Prometheus
    EmbedBatch -.-> Prometheus
    LLMEngine -.-> Prometheus
    VectorDB -.-> Prometheus
    APIEndpoints -.-> Prometheus
    
    Router -.-> Loki
    ParserXLS & ParserPDF & OCR -.-> Loki
    LLMEngine -.-> Loki
    
    QueryPreprocess -.-> Jaeger
    HybridSearch -.-> Jaeger
    LLMEngine -.-> Jaeger
    
    Prometheus --> Grafana
    Prometheus --> AlertManager
    
    %% Health checks
    VectorDB -.-> Readiness
    LLMEngine -.-> Readiness
    Readiness --> HealthAPI
    
    PrimaryQueue -.-> Liveness
    APIEndpoints -.-> Liveness
    Liveness --> HealthAPI
    
    HealthAPI --> User
    
    %% ============================================
    %% RESOURCE ALLOCATION
    %% ============================================
    
    LLMEngine -.-> GPU
    EmbedBatch -.-> GPU
    Reranker -.-> GPU
    
    VectorDB -.-> Disk
    Snapshot -.-> Disk
    Loki -.-> Disk
    
    PrimaryQueue -.-> RAM
    QueryCache -.-> RAM
    SemanticCache -.-> RAM
    
    ParserXLS & ParserPDF & OCR -.-> CPU
    Chunker -.-> CPU
    
    %% ============================================
    %% STYLING
    %% ============================================
    
    classDef critical fill:#ff6b6b,stroke:#c92a2a,stroke-width:3px,color:#fff
    classDef cache fill:#4dabf7,stroke:#1971c2,stroke-width:2px,color:#fff
    classDef monitor fill:#51cf66,stroke:#2f9e44,stroke-width:2px,color:#000
    classDef security fill:#ffd43b,stroke:#f59f00,stroke-width:2px,color:#000
    classDef storage fill:#e599f7,stroke:#9c36b5,stroke-width:2px,color:#fff
    
    class LLMEngine,Model,GPU critical
    class SemanticCache,QueryCache,ResultCache,SessionCache cache
    class Prometheus,Grafana,Loki,Jaeger monitor
    class Auth,RBAC,RateLimiter security
    class VectorDB,DenseVec,SparseVec,Metadata storage