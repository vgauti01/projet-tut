# Copiez ce fichier vers .env et remplissez les secrets
# NE PAS commiter le fichier .env sur git !

# =============================================================================
# SECRETS (Clés de sécurité)
# =============================================================================

# Clé maîtresse pour accéder à l'instance Meilisearch
MEILI_MASTER_KEY=votre-cle-secrete-ici-32-chars

# Identifiants administrateur pour l'interface Grafana (Supervision)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=votre-mot-de-passe-securise

# Clés de sécurité pour l'API et les jetons JWT
API_SECRET_KEY=votre-cle-secrete-api-32-chars
JWT_SECRET=votre-cle-secrete-jwt-32-chars

# =============================================================================
# CONFIGURATION DE L'APPLICATION
# =============================================================================

# Mode développement (active le hot reload de l'API)
# Valeurs: true | false (par défaut: false)
DEV_MODE=false

# URLs des services (utilisant le réseau interne Docker)
MEILI_URL=http://meilisearch:7700
QDRANT_URL=http://qdrant:6333
INDEX_NAME=docs

# Configuration du modèle et de la recherche
# Modèle d'embeddings pour la vectorisation (ex: multilingue pour le français)
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
#EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# Modèle de reranking pour affiner la pertinence des résultats
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Paramètres de recherche
# TOP_K : Nombre de résultats finaux retournés à l'utilisateur
TOP_K=5
# RRF_K : Paramètre pour l'algorithme de fusion Reciprocal Rank Fusion
RRF_K=60
# MIN_SCORE_THRESHOLD : Seuil de score minimum (0 à 1) pour filtrer les résultats non pertinents
MIN_SCORE_THRESHOLD=0.01
# SEARCH_MULTIPLIER : Multiplicateur pour la recherche initiale (pour avoir plus de candidats à reranker)
SEARCH_MULTIPLIER=3

# Configuration CORS (adresses autorisées à communiquer avec l'API)
CORS_ORIGINS=http://localhost:5173,https://votre-domaine.com

# Configuration de l'ingestion (découpage des documents)
# Dossier contenant les documents sources
DOCS_DIR=/workdir/data/docs
# Taille cible des morceaux de texte (en caractères)
CHUNK_SIZE=800
# Chevauchement entre les morceaux pour conserver le contexte (en caractères)
CHUNK_OVERLAP=200

# =============================================================================
# CONFIGURATION LLM (Optionnel - pour la génération de réponses)
# =============================================================================

# Décommentez pour activer les fonctionnalités liées au LLM local (ex: Llama)
# LLM_MODEL_PATH=/app/models/Qwen3-1.7B.Q6_K.gguf
# LLM_N_CTX=4096
# LLM_N_THREADS=0
# LLM_GPU_LAYERS=0
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=512
# LLM_MAX_HISTORY=5

# =============================================================================
# SUPERVISION / MONITORING (Optionnel - uniquement avec --profile monitoring)
# =============================================================================

# Durée de conservation des données dans Prometheus (ex: 15 jours)
PROMETHEUS_RETENTION=15d

# =============================================================================
# PARAMÈTRES DE PRODUCTION
# =============================================================================

# Environnement (production ou development)
NODE_ENV=production
LOG_LEVEL=info

# Sécurité : Activation des en-têtes HSTS et CSP
ENABLE_HSTS=true
ENABLE_CSP=true

# Limitation du débit (Rate Limiting) : requêtes max par minute
RATE_LIMIT_REQUESTS_PER_MINUTE=60
