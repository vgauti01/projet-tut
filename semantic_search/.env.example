# Copy this file to .env and fill in the secrets
# DO NOT commit .env to git!

# =============================================================================
# SECRETS)
# =============================================================================

MEILI_MASTER_KEY=your-secret-key-here-32-chars

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-password-here

# API Security Keys
API_SECRET_KEY=your-api-secret-key-32-chars
JWT_SECRET=your-jwt-secret-key-32-chars

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Service URLs (internal Docker networking)
MEILI_URL=http://meilisearch:7700
QDRANT_URL=http://qdrant:6333
INDEX_NAME=docs

# Model Configuration
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search Parameters
TOP_K=5
RRF_K=60
MIN_SCORE_THRESHOLD=0.01
SEARCH_MULTIPLIER=3

# CORS (adjust for production)
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Ingestion Configuration
DOCS_DIR=/workdir/data/docs
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# =============================================================================
# LLM CONFIGURATION (Optional)
# =============================================================================

# Uncomment and configure to enable LLM features
# LLM_MODEL_PATH=/app/models/your-model.gguf
# LLM_N_CTX=2048
# LLM_N_THREADS=0
# LLM_GPU_LAYERS=0
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=512
# LLM_MAX_HISTORY=5

# =============================================================================
# MONITORING (Optional - only with --profile monitoring)
# =============================================================================

# Prometheus retention
PROMETHEUS_RETENTION=15d

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Environment
NODE_ENV=production
LOG_LEVEL=info

# Security Headers
ENABLE_HSTS=true
ENABLE_CSP=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
