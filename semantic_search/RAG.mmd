flowchart TD
    %% --- DÉFINITION DES STYLES ---
    classDef default fill:#fff,stroke:#333,stroke-width:1px;
    classDef input fill:#fff3e0,stroke:#ff9800,stroke-width:2px,rx:5,ry:5,color:#ef6c00;
    classDef process fill:#e1f5fe,stroke:#039be5,stroke-width:2px,rx:5,ry:5,color:#01579b;
    classDef ai fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,rx:5,ry:5,color:#4a148c;
    classDef decision fill:#fff,stroke:#ff6f00,stroke-width:2px,shape:diamond;
    classDef storage fill:#e8f5e9,stroke:#43a047,stroke-width:2px,shape:cylinder,color:#1b5e20;
    classDef output fill:#e8eaf6,stroke:#3949ab,stroke-width:3px,rx:10,ry:10,color:#1a237e;
    classDef error fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#b71c1c;

    %% --- BLOC 1 : INGESTION & PARSING ---
    subgraph Docling_Process [<b>📂 PHASE 1 : EXTRACTION & NORMALISATION</b>]
        direction TB

        Start(fa:fa-folder-open Collecte Récursive<br/><i>rglob</i>):::input --> Router{Extension ?}:::decision

        %% ══════════════════════════════════════════
        %% BRANCHE PDF
        %% ══════════════════════════════════════════
        Router -- ".pdf" --> PDF_Load[fa:fa-eye Docling<br/>PdfFormatOption]:::process
        PDF_Load --> PDF_Layout["fa:fa-border-all Layout Analysis<br/><i>(détection zones)</i>"]:::ai
        PDF_Layout --> PDF_Type{Type de région ?}:::decision
        PDF_Type -- Texte natif --> PDF_Text[fa:fa-font Extract PDF Natif]:::process
        PDF_Type -- "Image<br/><i>(auto-détectée)</i>" --> PDF_OCR["fa:fa-camera OCR RapidOCR<br/><i>conditionnel</i>"]:::ai
        PDF_Type -- Tableau --> PDF_Table[fa:fa-table TableFormer]:::ai
        PDF_Text & PDF_OCR & PDF_Table --> PDF_Reflow[fa:fa-sort-amount-down Reflow &<br/>Reading Order]:::process
        PDF_Reflow --> DoclingOut

        PDF_Load -.-> PDF_Fail{Échec ?}:::decision
        PDF_Fail -- Oui --> PDF_Fb[fa:fa-tools PyMuPDF<br/>page.get_text]:::error
        PDF_Fb --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE IMAGE
        %% ══════════════════════════════════════════
        Router -- ".png .jpg<br/>.tiff .bmp" --> Img_OCR["fa:fa-camera OCR RapidOCR<br/><i>force_full_page=True</i>"]:::ai
        Img_OCR --> Img_Layout["fa:fa-border-all Layout Analysis<br/><i>(texte + tableaux)</i>"]:::ai
        Img_Layout --> Img_Type{Contenu détecté ?}:::decision
        Img_Type -- "Texte / Tableau" --> Img_Export[fa:fa-markdown Export Markdown]:::process
        Img_Export --> DoclingOut
        Img_Type -- "Aucun texte" --> Img_Empty["fa:fa-image Placeholder<br/><i>[Image sans texte détectable]</i>"]:::error
        Img_Empty --> RawOut

        Img_OCR -.-> Img_Fail{Échec ?}:::decision
        Img_Fail -- Oui --> Img_Fb["fa:fa-tools pytesseract + PIL<br/><i>lang=eng+fra</i>"]:::error
        Img_Fb --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE DOCX
        %% ══════════════════════════════════════════
        Router -- ".docx" --> DOCX_Load["fa:fa-file-word Docling<br/>WordFormatOption<br/><i>do_ocr=True</i>"]:::process
        DOCX_Load --> DOCX_Struct[fa:fa-heading Titres & Styles]:::process
        DOCX_Struct --> DOCX_Lists[fa:fa-list Listes à puces]:::process
        DOCX_Lists --> DOCX_Tables[fa:fa-table Tables structurées]:::process
        DOCX_Tables --> DOCX_ImgOcr["fa:fa-camera OCR RapidOCR<br/><i>images embarquées</i>"]:::ai
        DOCX_ImgOcr --> DoclingOut

        DOCX_Load -.-> DOCX_Fail{Échec ?}:::decision
        DOCX_Fail -- Oui --> DOCX_Fb["fa:fa-tools python-docx<br/><i>paragraphes uniquement</i>"]:::error
        DOCX_Fb --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE PPTX
        %% ══════════════════════════════════════════
        Router -- ".pptx" --> PPTX_Load["fa:fa-file-powerpoint Docling<br/>PowerpointFormatOption<br/><i>do_ocr=True</i>"]:::process
        PPTX_Load --> PPTX_Slides[fa:fa-clone Slides & Zones de texte]:::process
        PPTX_Slides --> PPTX_Notes[fa:fa-sticky-note Notes présentateur]:::process
        PPTX_Notes --> PPTX_Tables[fa:fa-table Tables par slide]:::process
        PPTX_Tables --> PPTX_ImgOcr["fa:fa-camera OCR RapidOCR<br/><i>images embarquées</i>"]:::ai
        PPTX_ImgOcr --> DoclingOut

        PPTX_Load -.-> PPTX_Fail{Échec ?}:::decision
        PPTX_Fail -- Oui --> PPTX_Fb["fa:fa-tools python-pptx<br/><i>shapes + notes par slide</i>"]:::error
        PPTX_Fb --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE XLSX
        %% ══════════════════════════════════════════
        Router -- ".xlsx" --> XLSX_Load[fa:fa-file-excel Docling<br/>DocumentConverter]:::process
        XLSX_Load --> XLSX_Sheets[fa:fa-layer-group Feuilles de calcul]:::process
        XLSX_Sheets --> XLSX_Headers[fa:fa-heading En-têtes & Hiérarchies]:::process
        XLSX_Headers --> XLSX_Cells[fa:fa-th Relations cellules]:::process
        XLSX_Cells --> DoclingOut

        XLSX_Load -.-> XLSX_Fail{Échec ?}:::decision
        XLSX_Fail -- Oui --> XLSX_Fb["fa:fa-tools openpyxl<br/><i>header: val par feuille</i>"]:::error
        XLSX_Fb --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE HTML
        %% ══════════════════════════════════════════
        Router -- ".html .htm" --> HTML_Load[fa:fa-code Docling<br/>DocumentConverter]:::process
        HTML_Load --> HTML_DOM[fa:fa-sitemap Parse DOM]:::process
        HTML_DOM --> HTML_Struct[fa:fa-heading Sections / Titres / Paragraphes]:::process
        HTML_Struct --> HTML_Tables[fa:fa-table Tables structurées]:::process
        HTML_Tables --> HTML_Clean["fa:fa-eraser Nettoyage<br/><i>script / style / meta</i>"]:::process
        HTML_Clean --> DoclingOut

        HTML_Load -.-> HTML_Fail{Échec ?}:::decision
        HTML_Fail -- Oui --> HTML_Fb["fa:fa-tools BeautifulSoup<br/><i>get_text visible uniquement</i>"]:::error
        HTML_Fb --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE CSV
        %% ══════════════════════════════════════════
        Router -- ".csv" --> CSV_Read["fa:fa-file-csv csv.DictReader<br/><i>UTF-8 errors=replace</i>"]:::process
        CSV_Read --> CSV_Batch["fa:fa-layer-group Batches 500 lignes"]:::process
        CSV_Batch --> CSV_Format["fa:fa-tag Format clé: valeur"]:::process
        CSV_Format --> RawOut

        %% ══════════════════════════════════════════
        %% BRANCHE TXT / MD / RST
        %% ══════════════════════════════════════════
        Router -- ".txt .md .rst" --> TXT_Read["fa:fa-file-alt read_text<br/><i>UTF-8 errors=replace</i>"]:::process
        TXT_Read --> RawOut

        %% ══════════════════════════════════════════
        %% CONVERGENCE
        %% ══════════════════════════════════════════
        DoclingOut["fa:fa-cube DoclingDocument"]:::process --> Enrich[fa:fa-plus Enrichissement Meta]:::process
        Enrich --> Export[fa:fa-markdown Export Markdown]:::process
        Export --> Step9_Final

        RawOut["fa:fa-align-left Texte brut<br/><i>sans DoclingDocument</i>"]:::process --> Step9_Final

        Step9_Final(["fa:fa-check-circle Markdown<br/><i>± DoclingDocument</i>"]):::output
    end

    %% --- BLOC 2 : CHUNKING INTELLIGENT ---
    subgraph Chunking_Process ["<b>✂️ PHASE 2 : DÉCOUPAGE (CHUNKING)</b>"]
        direction TB
        Step9_Final --> Check_Docling{DoclingDocument<br/>disponible ?}:::decision

        Check_Docling -- Oui --> Hybrid_Chunk["fa:fa-sitemap HybridChunker<br/><i>Docling structure-aware</i>"]:::ai
        Hybrid_Chunk --> Contextualize["fa:fa-indent contextualize()<br/><i>Headings parents injectés</i>"]:::process
        Contextualize --> Has_Chunks{Chunks<br/>produits ?}:::decision
        Has_Chunks -- Oui --> Gen_ID_H[fa:fa-fingerprint ID Unique MD5]:::ai
        Has_Chunks -- Non --> Fallback_Text

        Check_Docling -- Non --> Fallback_Text["fa:fa-cut chunk_text<br/><i>Fallback récursif</i>"]:::process
        Fallback_Text --> Clean_Text[fa:fa-eraser clean_pdf_artifacts]:::process
        Clean_Text --> Gen_ID_H

        Gen_ID_H --> Vector_Ready(["fa:fa-check-double Chunks Prêts<br/><i>+ headings metadata</i>"]):::output
    end

    %% --- BLOC 3 : STOCKAGE & RECHERCHE ---
    subgraph Storage_Process [<b>🚀 PHASE 3 : VECTORISATION & STOCKAGE</b>]
        direction TB
        Vector_Ready --> Batch_Queue[fa:fa-layer-group Batch Accumulator]:::process
        Batch_Queue --> Batch_Full_2{Batch Plein?}:::decision

        Batch_Full_2 -- Oui --> Process_Batch[fa:fa-cogs Traitement]:::process
        Process_Batch --> Call_Model["fa:fa-brain Modèle Embedding<br/><i>Text → Vector</i>"]:::ai
        Call_Model --> Embedding[fa:fa-project-diagram Vecteurs]:::process

        Embedding --> Dual_Write{Dispatcher}:::decision

        Dual_Write -->|Texte| Meili_Branch["fa:fa-search Meilisearch<br/><i>(Keyword Search)</i>"]:::process
        Meili_Branch --> Meili_Index[(fa:fa-database Index Meili)]:::storage

        Dual_Write -->|Vecteur| Qdrant_Branch["fa:fa-rocket Qdrant<br/><i>(Semantic Search)</i>"]:::process
        Qdrant_Branch --> Qdrant_Coll[(fa:fa-database Collection Qdrant)]:::storage

        Meili_Branch -.-> Log_Error[fa:fa-exclamation-circle Log Erreur]:::error
        Qdrant_Branch -.-> Log_Error
    end

    %% Styles Subgraphs
    style Docling_Process fill:#f8fcff,stroke:#0277bd,stroke-width:2px,stroke-dasharray: 5 5
    style Chunking_Process fill:#fff8e1,stroke:#ff6f00,stroke-width:2px,stroke-dasharray: 5 5
    style Storage_Process fill:#f1f8e9,stroke:#558b2f,stroke-width:2px,stroke-dasharray: 5 5