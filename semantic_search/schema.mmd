
flowchart LR
    subgraph Client["Client (UI/outil)"]
        UQ["Requête utilisateur (JSON)"]
        UR["Réponse structurée (JSON)"]
    end

    subgraph API["API FastAPI (app:8000)"]
        ASK["/ask (POST)"]
        FUSION["Module de fusion & filtrage"]
        HIGHLIGHT["Mise en forme / highlights"]
    end

    subgraph Meili["Moteur lexical - Meilisearch (7700)"]
        IDX["Index 'docs' (BM25)\ncontent, title, path, page, chunk_id"]
        SRCH["/indexes/docs/search"]
        SYNO["Synonymes/Settings"]
    end

    subgraph Qdrant["Moteur vectoriel - Qdrant (6333)"]
        COL["Collection 'docs'\nEmbedding dims = 384 (MiniLM)\nPayload: title, path, page, chunk_id"]
        VSRCH["Search (cosine/topK)"]
    end

    subgraph Emb["Embeddings"]
        EMQ["Encoder la requête → vecteur (MiniLM L6/L12)"]
        EMD["Encoder les chunks → vecteurs (pipeline d'ingestion)"]
    end

    subgraph Ingest["Ingestion PDF (ingestor)"]
        PDF["Dossier data/docs/*.pdf"]
        EX["Extraction pages (PyMuPDF)"]
        CH["Chunking (taille/overlap)"]
        PUT_MEILI["Batch POST → Meilisearch"]
        PUT_QDR["Batch Upsert → Qdrant"]
    end

    %% Flux ingestion
    PDF --> EX --> CH
    CH --> PUT_MEILI --> IDX
    CH --> EMD --> PUT_QDR --> COL

    %% Flux requête (Mode A - Meili seul)
    UQ --> ASK
    ASK --> SRCH --> IDX
    SRCH --> FUSION
    FUSION --> HIGHLIGHT --> UR

    %% Flux requête (Mode B - Hybride Meili + Qdrant)
    UQ .-> EMQ -. vecteur .-> VSRCH --> COL --> FUSION
    ASK --> SYNO
